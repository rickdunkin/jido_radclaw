# JidoClaw Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ─── LLM Provider Keys ─────────────────────────────────────────
# Only set the key for your chosen provider. Run `/setup` in the REPL to configure.

# Ollama (local — no key needed, or use "ollama" as placeholder)
# OLLAMA_API_KEY=ollama

# Ollama Cloud
# OLLAMA_API_KEY=your-ollama-cloud-key

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GOOGLE_API_KEY=AIza...

# Groq
# GROQ_API_KEY=gsk_...

# xAI (Grok)
# XAI_API_KEY=xai-...

# OpenRouter (200+ models via unified API)
# OPENROUTER_API_KEY=sk-or-...

# ─── Platform ──────────────────────────────────────────────────

# Gateway port
# JIDOCLAW_PORT=4000

# ─── Channel Adapters ─────────────────────────────────────────

# Discord
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_GUILD_ID=your-guild-id

# ─── Clustering (optional) ────────────────────────────────────

# Required when cluster_enabled + the :gossip strategy — encrypts
# discovery heartbeats; the app refuses to boot clustering without it.
# Use the same value on every node. Also set a non-default Erlang
# distribution cookie (see README "Clustering").
# JIDOCLAW_CLUSTER_SECRET=

# Trusted peer allowlist for the solution-sharing network: comma-
# separated base64 Ed25519 public keys (from each peer's
# .jido/identity.json). Unset = all inbound network messages dropped;
# outbound sharing still works.
# JIDOCLAW_NETWORK_PEERS=

# ─── Canopy Workspace (optional) ──────────────────────────────

# CANOPY_WORKSPACE_URL=https://your-org.canopy.dev
# CANOPY_API_KEY=your-canopy-key

JIDOCLAW_ADMIN_EMAILS=
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
CLOAK_KEY=